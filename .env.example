# Copy to .env and fill in values
DB_PATH=xsettlers.db
GAME_CONFIG_PATH=config/game_config.yaml
CONFIDENCE_DECAY=0.9          # 10% fog-of-war decay per tick
GAME_TICK_SECONDS=300         # Seconds between automatic end-of-turn ticks

# Stopgap perimeter auth for the /mcp HTTP endpoint (Bearer <token>).
# Required -- requests are rejected if unset. Same value must be configured
# on whatever calls /mcp (e.g. Slackbot). Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_SHARED_SECRET=
