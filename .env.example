# Copy to .env and fill in values
DB_PATH=xsettlers.db
GAME_CONFIG_PATH=config/game_config.yaml
CONFIDENCE_DECAY_PER_TURN=20  # Confidence points lost per tick by an unoccupied
                              # sector. Flat subtraction from 100, so 20 means a
                              # sector blinks off the map 5 turns after it was
                              # last seen. Replaces the old CONFIDENCE_DECAY
                              # multiplier (0.9), which is no longer read.
GAME_TICK_SECONDS=300         # Seconds between automatic end-of-turn ticks

# NOTE: MCP_SHARED_SECRET is gone (2026-07-31). /mcp has no perimeter auth --
# the Bearer gate was incompatible with MCP client connector flows, which take
# a URL and optionally OAuth but have no field for a static header. Access
# control now rests entirely on player_token. See xsettlers_mcp/server.py's
# SECURITY POSTURE comment before assuming this endpoint is protected.
